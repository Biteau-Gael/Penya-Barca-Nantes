# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://penya:YOUR_PASSWORD_HERE@localhost:5432/penya_barca_nantes

# Redis (use redis://:YOUR_PASSWORD@host:6379 in production)
REDIS_URL=redis://localhost:6379

# Auth (Better Auth - must be at least 32 chars of random data)
AUTH_SECRET=YOUR_AUTH_SECRET_HERE_MIN_32_CHARS

# App URL (required - the public URL of the application)
APP_URL=http://localhost:3000

# API Football (via RapidAPI — Free API Live Football Data)
API_FOOTBALL_KEY=your-rapidapi-key

# --- Production (Synology NAS) ---
# Decommenter et remplir pour la production
# POSTGRES_PASSWORD=your-strong-postgres-password
# REDIS_PASSWORD=your-strong-redis-password
